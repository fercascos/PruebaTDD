# =============================================================================
#  Variables de entorno · PLANTILLA
#
#  [REQ] Este fichero NO contiene ni un solo valor real. Cópielo a `.env` y
#  rellénelo. `.env` está en .gitignore y nunca debe versionarse.
#
#  Generar secretos:  openssl rand -hex 32
# =============================================================================

# ── Aplicación ───────────────────────────────────────────────────────────────
APP_ENV=local                      # local | staging | production
APP_SECRET_KEY=                    # openssl rand -hex 32
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
# El formato del registro lo decide APP_ENV, no una variable aparte: en `local`
# se escribe en texto, que se lee; en `staging` y `production`, en JSON, que se
# indexa. Es la misma información.

# ── Base de datos ────────────────────────────────────────────────────────────
# El usuario de aplicación NO debe tener BYPASSRLS ni ser propietario de las
# tablas: si lo fuera, las políticas de Row Level Security no se le aplicarían
# y el aislamiento entre organizaciones dejaría de existir.
DATABASE_URL=                      # postgresql+psycopg://usuario:clave@host:5432/base
DATABASE_MIGRATION_URL=            # usuario con DDL, distinto del de aplicación
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis y colas ────────────────────────────────────────────────────────────
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Almacenamiento de objetos (compatible S3) ────────────────────────────────
# `disco` es para desarrollo y para la suite. `s3` es el de producción, y trae
# la barrera 4: versionado + Object Lock sobre originals/, documents/ y
# templates/.
STORAGE_BACKEND=disco              # disco | s3
STORAGE_LOCAL_DIR=./var/objetos    # solo con STORAGE_BACKEND=disco

STORAGE_ENDPOINT_URL=              # vacío para AWS; con valor, se usa ruta (MinIO)
# El extremo por el que el NAVEGADOR alcanza el almacén, si no es el mismo que
# usa el servidor. Vacío = son el mismo. Hace falta con MinIO en contenedores
# (el servidor llega por `objetos:9000` y el navegador no resuelve ese nombre) y
# con S3 detrás de un extremo privado de VPC. La URL firmada nace ya apuntando
# aquí, porque la firma v4 cubre el `Host` y reescribirla después la invalida.
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_BUCKET=
# Déjelas VACÍAS siempre que pueda: botocore usará el rol de la instancia o el
# perfil, y la credencial más segura es la que no hay que guardar.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_ENABLE_OBJECT_LOCK=true
# GOVERNANCE | COMPLIANCE. COMPLIANCE es más fuerte —nadie, ni la cuenta raíz,
# puede borrar antes de tiempo— y por eso NO es el valor por defecto: impediría
# atender un derecho de supresión durante los años que dure la retención, y
# cambiaría un riesgo técnico por uno legal. GOVERNANCE protege igual del
# accidente (hace falta s3:BypassGovernanceRetention, que la aplicación no
# tiene) y deja una vía auditable para el borrado legítimo.
STORAGE_OBJECT_LOCK_MODE=GOVERNANCE
STORAGE_OBJECT_LOCK_DAYS=3650
#
# EL BUCKET HAY QUE CREARLO CON VERSIONADO Y OBJECT LOCK. No se pueden activar
# después: si el bucket se creó sin ellos, hay que crear otro y copiar. Al
# arrancar, la aplicación lo comprueba y lo registra en el log si falta.
#
#   aws s3api create-bucket --bucket MI-BUCKET --object-lock-enabled-for-bucket \
#     --region eu-west-1 --create-bucket-configuration LocationConstraint=eu-west-1
#
# [LIM] El adaptador está probado contra `moto`, un simulador en proceso. Eso
# ejercita el código —incluido que S3 rechace borrar una versión retenida—,
# pero NO demuestra que su bucket esté bien configurado.

# ── Autenticación ────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREVIOUS_PUBLIC_KEY_PEM=       # permite rotar sin cerrar sesiones
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
FIELD_ENCRYPTION_KEY=              # AES-256-GCM para secretos TOTP

# ── Correo ───────────────────────────────────────────────────────────────────
# Sin SMTP_HOST o sin MAIL_FROM no se envía nada: se registra en el log que NO
# se ha enviado, con el destinatario y el asunto pero NUNCA el cuerpo —un
# enlace de recuperación en el log está al alcance de más gente que el buzón
# del destinatario—. Una aplicación recién desplegada sin SMTP no debe fallar
# al pedir una recuperación ni fingir que ha mandado un correo.
#
# Se exige STARTTLS: si el servidor no lo ofrece, NO se envía en claro. El
# mensaje lleva un enlace de recuperación.
#
# [LIM] El adaptador no se ha probado contra un servidor SMTP real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=                         # p. ej. Due diligence <no-responder@ejemplo.example>

# ── Antimalware y conversión ─────────────────────────────────────────────────
# Desactivado por defecto, y SE NOTA: sin antivirus cada fichero queda
# «NO_ANALIZADO», que no es lo mismo que limpio, y así se dice. Habilitarlo sin
# CLAMAV_HOST no arranca: sería peor que no habilitarlo, porque quien despliega
# creería estar protegido.
#
# [LIM] El adaptador habla el protocolo INSTREAM de clamd y está probado contra
# un servidor de mentira que responde ese protocolo. NO se ha probado contra un
# ClamAV real con base de firmas.
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
LIBREOFFICE_BIN=/usr/bin/soffice
PPTX_MAX_UNCOMPRESSED_MB=200
PPTX_RENDER_TIMEOUT_SECONDS=180

# ── Fuentes corporativas ─────────────────────────────────────────────────────
# Gotham es COMERCIAL y LICENCIADA. Los .otf NO están en el repositorio: se
# descargan al arrancar el worker desde un artefacto privado y se instalan con
# fc-cache. Ver docs/operacion/instalar-fuentes.md
CORPORATE_FONTS_BUCKET=
CORPORATE_FONTS_PREFIX=fonts/
CORPORATE_FONTS_INSTALL_DIR=/usr/share/fonts/opentype/corporate
CORPORATE_FONTS_REQUIRED=Gotham Light,Gotham Book,Gotham Medium,Gotham Bold,Gotham Black,Gotham Ultra
FONT_FALLBACK_WARN=true
# Incrustar las fuentes en el PPTX generado. Desactivado: los ficheros lo
# permiten (fsType = Preview & Print) pero está PENDIENTE de confirmar contra
# el contrato de licencia (P-39), y hoy las plantillas del cliente tampoco
# incrustan.
PPTX_EMBED_FONTS=false

# ── Límites de archivo ───────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
MAX_BATCH_UPLOAD_MB=500

# ── Mapas (adaptador configurable) ───────────────────────────────────────────
MAP_PROVIDER=
MAP_TILE_URL_TEMPLATE=
MAP_API_KEY=
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# ── Fuentes de precios ───────────────────────────────────────────────────────
# [REQ] P-06 · NO hay ninguna fuente de precios externa, ni está prevista. Los
# precios se teclean y se editan a mano. Ninguna fuente externa se habilita por
# configuración: se habilita en la aplicación, y solo tras registrar licencia
# vigente y revisión de las condiciones de uso por un administrador.
PRICE_SOURCE_HTTP_TIMEOUT_SECONDS=10
PRICE_SOURCE_USER_AGENT=           # identificación honesta + URL de contacto

# ── Observabilidad ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ── Retención ────────────────────────────────────────────────────────────────
DEFAULT_RETENTION_MONTHS=84
TRASH_PURGE_DAYS=30
PHOTO_TRASH_PURGE_DAYS=30          # días que una foto permanece recuperable
EXPORT_EXPIRY_DAYS=7

# ── Cartografía del mapa de fotografías (§15.9) ──────────────────────────────
# [REQ] Se deja VACÍO a propósito. Sin proveedor, el mapa funciona igual —las
# posiciones y las distancias son correctas, hay escala— y la aplicación no
# contacta con ningún servidor externo.
#
# La biblioteca (Leaflet, BSD-2) es libre sin condiciones. Las TESELAS no:
#
#   · tile.openstreetmap.org NO es un CDN de uso libre. Su Tile Usage Policy
#     lo limita a uso ligero y no comercial, exige un User-Agent identificable
#     y pide expresamente que el uso intensivo se autoaloje o vaya a un
#     proveedor de pago. Una consultora usándolo a diario estaría fuera de esas
#     condiciones. https://operations.osmfoundation.org/policies/tiles/
#
#   · Las opciones honestas son: autoalojar teselas (los datos de OSM son ODbL
#     y se pueden servir uno mismo), contratar un proveedor, o dejarlo vacío.
#
# Poner una URL aquí es aceptar las condiciones de quien la sirve. Esa decisión
# es de quien despliega, no de quien programa. Estas variables las lee el
# frontend en tiempo de compilación (prefijo VITE_), no el backend.
VITE_MAP_TILE_URL=                 # p. ej. https://{s}.ejemplo.example/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=              # obligatoria si el proveedor la exige
