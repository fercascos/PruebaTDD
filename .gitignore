# ── Secretos ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Tipografías ──────────────────────────────────────────────────────────────
# No se versionan, aunque tras P-39 la licencia lo permitiría: un binario en el
# repositorio se actualiza a mano y nadie revisa su procedencia al año
# siguiente. Se instalan por paquete: `make fonts-install`.
# Hay además una prueba de CI que falla si aparece alguna: un .gitignore se
# salta con `git add -f`, la prueba no.
assets/fonts/**/*.otf
assets/fonts/**/*.ttf
assets/fonts/**/*.woff*
!assets/fonts/README.md

# ── Material real de cliente ─────────────────────────────────────────────────
# Plantillas y fotografías reales llevan datos de activos identificables.
tests/fixtures/real/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/

# ── Sistema ──────────────────────────────────────────────────────────────────
.DS_Store
*.log

# ── Almacén de objetos local ─────────────────────────────────────────────────
# `AlmacenEnDisco` escribe aquí las fotografías, documentos y plantillas
# subidas en desarrollo. Son binarios de trabajo, y en cuanto alguien pruebe
# con material real serían fotografías de activos identificables en el
# repositorio. Ver STORAGE_LOCAL_DIR en .env.example.
apps/api/var/
var/objetos/
# `[REQ]` Certificado y CLAVE PRIVADA del SMTP de desarrollo, que genera
# `make certificados`. Se regeneran solos; una clave privada no se versiona ni
# aunque sea de mentira, porque el día que alguien copie el patrón para una de
# verdad ya no habrá nada que lo pare.
var/certificados-desarrollo/

# ── Caché de compilación de TypeScript ───────────────────────────────────────
*.tsbuildinfo

# ── La grabación del prototipo navegable ─────────────────────────────────────
# 0,7 MB de respuestas de la API, con las fotografías dentro. Son datos
# ficticios y podrían versionarse, pero envejecen en cuanto la API cambia y un
# fichero generado que se queda viejo dentro del repositorio acaba enseñando
# una aplicación que ya no existe. Se regenera con `npm run prototipo:grabar`.
apps/web/prototipo/grabacion.json
