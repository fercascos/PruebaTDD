{
  "name": "@tdd/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sin-red": "node herramientas/comprobar-sin-red.mjs",
    "test:anotador": "node herramientas/comprobar-anotador.mjs",
    "test:mapa": "node herramientas/comprobar-mapa.mjs",
    "test:riesgos": "node herramientas/comprobar-riesgos.mjs",
    "test:comparador": "node herramientas/comprobar-comparador.mjs",
    "test:inventario": "node herramientas/comprobar-inventario.mjs",
    "test:importacion": "node herramientas/comprobar-importacion.mjs",
    "test:exportacion": "node herramientas/comprobar-exportacion.mjs",
    "test:sistema-fotos": "node herramientas/comprobar-sistema-de-fotos.mjs",
    "test:recuperacion": "node herramientas/comprobar-recuperacion.mjs",
    "lint": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test:revision": "node herramientas/comprobar-revision-documental.mjs",
    "test:concurrencia": "node herramientas/comprobar-concurrencia.mjs",
    "test:worker": "node herramientas/comprobar-worker.mjs",
    "test:ubicaciones": "node herramientas/comprobar-ubicaciones.mjs",
    "test:safari": "TDD_NAVEGADOR=webkit TDD_DISPOSITIVO=\"iPhone 14\" node herramientas/comprobar-safari.mjs",
    "test:movil": "TDD_DISPOSITIVO=\"iPhone 14\" node herramientas/comprobar-safari.mjs",
    "test:android": "TDD_DISPOSITIVO=\"Galaxy S9+\" node herramientas/comprobar-safari.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "@types/leaflet": "^1.9.20"
  }
}
